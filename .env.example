# Local environment variables — copy to .env and fill in real values.
# .env is git-ignored; never commit real secrets.

# JWT signing secret (base64, >= 32 bytes for HS256). Generate a fresh one:
#   openssl rand -base64 64
JWT_SECRET=

# Database connection overrides for local runs (Docker Compose already provides these).
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Kafka connection overrides for local runs (Docker Compose already provides this broker).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=railway-reservation-group

# Razorpay API keys (regenerate in https://dashboard.razorpay.com — test mode:
# Settings > API Keys). Key id starts with rzp_test_ / rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret (Settings > Webhooks)
RAZORPAY_WEBHOOK_SECRET=